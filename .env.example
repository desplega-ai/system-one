# Bun loads .env automatically. Each provider reads its key at call time.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=

# Arcade server (all optional).
# Daily USD caps per UTC day, in total, per provider, per visitor (cookie) and per IP. Default: {"dailyUsd":1}
# A public site: {"dailyUsd":5,"visitorUsd":0.1,"ipUsd":0.3}
SYSTEM_ONE_BUDGET=
# Salt for the IP hashes in the database. Without it, a random salt per start.
SYSTEM_ONE_SALT=
# SQLite file. Default: data/arcade.sqlite
SYSTEM_ONE_DB=
# Default: 3300
PORT=
