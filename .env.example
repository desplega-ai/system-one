# Bun loads .env automatically. Each provider reads its key at call time.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=

# Arcade server (all optional).
# Daily USD caps per UTC day, in total and per provider. Default: {"dailyUsd":1}
SYSTEM_ONE_BUDGET=
# SQLite file. Default: data/arcade.sqlite
SYSTEM_ONE_DB=
# Default: 3300
PORT=
